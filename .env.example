# ============================================================
#  析知 XiZhi · 环境变量模板
#  用法：复制为 .env 后按需修改。.env 已在 .gitignore 中，不会被提交。
# ============================================================

# ---- 数据库 ----
# SQLite 文件路径。程序会自动开启 WAL、foreign_keys=ON、busy_timeout
DB_PATH=./app.db

# ---- 文件存储 ----
UPLOAD_DIR=./uploads
# 单文件上传大小上限（MB）
MAX_UPLOAD_MB=50

# ---- 服务 ----
# 后端监听端口
APP_PORT=8000
# 前端开发服务器地址（用于开发期 CORS 白名单，生产环境为单容器同源无需配置）
DEV_FRONTEND_ORIGIN=http://localhost:5173

# ============================================================
#  LLM 配置：保留但不启用
# ============================================================
# 背景：赛事规则不允许作品调用第三方大模型 API（SPEC §4.8 / 决策 D-13）。
# 当前架构为「离线构建 + 在线零模型依赖」：
#   · 构建期抽取 —— LearnBuddy 平台（人工操作，不需要 API Key）
#   · 运行期     —— 检索 / 图算法 / 状态机全部为纯算法，不调用模型
# 因此下面这些变量当前【不需要填】。
# 保留它们是为了：若规则口径变化，一行配置即可切回云端 Provider，不用改业务代码。
# 对应说明见 docs/prompt-contracts.md §0.0。

# LLM_ROUTING_PATH=./config/llm_routing.yaml
# DEEPSEEK_API_KEY=
# BAILIAN_API_KEY=
